[init]
  defaultBranch = master
[core]
  pager = delta
	excludesfile = /root/.gitignore_global
[user]
  email = dougmaitelli@gmail.com
  name = Douglas Maitelli
[color]
  ui = auto
[delta]
  navigate = true
[interactive]
  diffFilter = delta --color-only
[pull]
  rebase = true
[push]
  default = simple
[merge]
  confictstyle = zdiff3

[alias]
  conflicts = !git ls-files --unmerged | cut -f2 | sort -u
  count-conflicts = !grep -c '^=======$'
  count-all-conflicts = !grep -c '^=======$' $(git conflicts)

[includeIf "gitdir:~/gitWork/"]
  path = ~/.gitconfig-work

[includeIf "gitdir:~/SAPDevelop/"]
  path = ~/.gitconfig-work

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
